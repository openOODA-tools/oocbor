// # oocbor IPC Module Anchor
//
// Logline: Integrates command-line options parser and Model Context Protocol stdio server.
//
// Setup: Bridges IPC routing and JSON-RPC dispatch to CBOR serializer engine.
//
// Beats:
//   1. Expose CLI argument parser and execution options.
//   2. Expose MCP tool dispatch and streaming message router.
//   3. Provide IPC subsystem health verification predicate.

import "ipc/json_field.oo";
import "ipc/cbor_opts.oo";
import "ipc/mcp_serve.oo";

pub fn verify_ipc_subsystem() -> Bool {
    let raw: String = "{\"method\":\"initialize\",\"id\":1}";
    let resp: String = handle_mcp_line(raw);
    let opts: CborOpts = default_cbor_opts();
    return chars_len(resp) > 0 && opts.action == "decode";
}
